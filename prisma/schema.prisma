generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UpdateStatus {
  DRAFT
  PUBLISHED
}

model Product {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updates   Update[]

  @@map("products")
}

model UpdateType {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updates        Update[]

  @@map("update_types")
}

model Update {
  id          String       @id @default(cuid())
  productId   String       @map("product_id")
  moduleName  String       @map("module_name")
  title       String
  description String
  releaseDate DateTime     @map("release_date")
  typeId      String       @map("type_id")
  version     String?
  reviewUrl   String?      @map("review_url")
  status      UpdateStatus @default(DRAFT)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  updateType UpdateType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([releaseDate])
  @@index([productId])
  @@index([typeId])
  @@index([status])
  @@map("updates")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  id          String    @id @default(cuid())
  ipKey       String    @unique @map("ip_key")
  attempts    Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  lastAttempt DateTime  @default(now()) @map("last_attempt")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([ipKey])
  @@map("login_attempts")
}

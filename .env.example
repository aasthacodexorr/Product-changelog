# PostgreSQL connection string (pooled - for queries in serverless/production & development)
DATABASE_URL="postgresql://neondb_owner:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30&pgbouncer=true"

# PostgreSQL connection string (unpooled / direct - required for Prisma migrations)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@endpoint.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Employee panel shared password
EMPLOYEE_PANEL_PASSWORD="change_this_to_a_secure_shared_password"

# Node environment ("development" locally, "production" on Vercel)
NODE_ENV="development"

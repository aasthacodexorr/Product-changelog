# DEVELOPMENT: Use SQLite for local development
DATABASE_URL="file:./prisma/dev.db"

# PRODUCTION: Use Neon PostgreSQL (uncomment and fill in when deploying)
# DATABASE_URL="postgresql://username:password@endpoint-pooler.region.aws.neon.tech/database?sslmode=require&channel_binding=require"
# DATABASE_URL_UNPOOLED="postgresql://username:password@endpoint.region.aws.neon.tech/database?sslmode=require"

# Employee panel shared password
EMPLOYEE_PANEL_PASSWORD="change_this_to_a_secure_shared_password"

# Node environment
NODE_ENV="development"

# Neon branch (only for production)
# NEON_BRANCH=production

# PostgreSQL connection string (pooled or local connection)
DATABASE_URL="postgresql://username:password@localhost:5432/product_changelog?schema=public"

# Direct unpooled connection string (required by Prisma migrations if using PgBouncer/Neon pooler)
DATABASE_URL_UNPOOLED="postgresql://username:password@localhost:5432/product_changelog?schema=public"

# Shared password for employee panel access (/panel)
EMPLOYEE_PANEL_PASSWORD="change_this_to_a_secure_shared_password"

# Node environment and port
NODE_ENV="production"
PORT="3000"
